{
  "schemaVersion": 1,
  "id": "itemsize",
  "version": "${version}",
  "name": "ItemSize",
  "description": "Customize the size of every item on the ground, in your hand and in your inventory.",
  "authors": ["ItemSize contributors"],
  "contact": {
    "sources": "https://github.com/noelshary/ItemSize"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.itemsize.client.ItemSizeClient"
    ]
  },
  "mixins": [
    {
      "config": "itemsize.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.165.0"
  }
}
