{
  "schemaVersion": 1,
  "id": "itemsize",
  "version": "${version}",
  "name": "ItemSize",
  "description": "A polished animated item dimension editor for decorative, building and utility items.",
  "authors": ["Neoloni"],
  "contact": {
    "homepage": "https://github.com/Neoloni/ItemSize",
    "sources": "https://github.com/Neoloni/ItemSize"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.neoloni.itemsize.client.ItemSizeClient"
    ]
  },
  "mixins": [
    {
      "config": "itemsize.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "=1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
